<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="toko.controller.FormProdukController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Form Produk Toko" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
   <bottom>
        <ScrollPane fitToWidth="true" prefHeight="643.0" prefWidth="392.0" BorderPane.alignment="CENTER">
            <content>
                <VBox prefHeight="594.0" prefWidth="390.0" spacing="16" styleClass="page">
                    <VBox prefHeight="438.0" prefWidth="326.0" spacing="12" styleClass="card">
                        <Label fx:id="judulFormLabel" styleClass="subtitle" text="Tambah Produk Baru" />
                        
                        <Label text="Nama Produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Roti Tawar" />
                        
                        <Label text="Kategori Produk" />
                        <ComboBox fx:id="jenisBox" maxWidth="Infinity" />
                        
                        <Label text="Harga Produk (Rp)" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                  <ImageView fx:id="imageViewPreview" fitHeight="128.0" fitWidth="185.0" pickOnBounds="true" preserveRatio="true" />
                  <Button mnemonicParsing="false" onAction="#pilihGambar" text="Upload IMG" />
                    </VBox>
                     
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan Produk" />
                </VBox>
            </content>
        </ScrollPane>
   </bottom>
</BorderPane>
